# ============================================
# 钉钉待办事项自动化催办系统 - 环境变量配置
# ============================================

# --- 钉钉应用配置 ---
# 在钉钉开放平台创建企业内部应用后获取
DINGTALK_APP_KEY=your_app_key_here
DINGTALK_APP_SECRET=your_app_secret_here

# --- 钉钉机器人配置 ---
# 群机器人Webhook地址（用于发送催办消息和预警通知）
DINGTALK_ROBOT_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx
# Webhook安全设置的签名密钥
DINGTALK_ROBOT_SECRET=your_robot_secret_here

# --- 钉钉在线文档配置 ---
# 钉钉在线文档的ID（从文档链接中提取）
DINGTALK_DOC_ID=your_doc_id_here
# 文档所在的空间ID
DINGTALK_SPACE_ID=your_space_id_here

# --- AI分析配置（可选，不填则使用规则引擎替代） ---
# 引擎选择: auto(自动选择) | gemini | kimi
AI_PROVIDER=auto

# Google Gemini（推荐，免费额度大）
# 在 https://aistudio.google.com/apikey 免费申请
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Kimi/月之暗面（国内平台，延迟低）
# 在 https://platform.moonshot.cn 注册获取
KIMI_API_KEY=your_kimi_api_key_here
KIMI_MODEL=moonshot-v1-8k

# --- 催办策略配置 ---
# 每日催办时间（24小时制，多个时间用逗号分隔）
REMINDER_TIMES=09:30,14:00,17:00
# 超时未更新的天数阈值（超过此天数触发预警）
OVERDUE_DAYS_THRESHOLD=2
# 高风险关键词（逗号分隔）
RISK_KEYWORDS=延期,阻塞,困难,无法,推迟,取消,暂停,风险,问题

# --- 预警通知配置 ---
# 管理员钉钉UserID（接收人工预警的管理者）
ADMIN_USER_ID=your_admin_user_id
# 预警级别阈值 (low/medium/high/critical)
ALERT_THRESHOLD=medium

# --- 阿里云 OSS 配置（报告上传） ---
# 用于将报告上传到 OSS，生成可分享链接
OSS_ACCESS_KEY_ID=your_access_key_id
OSS_ACCESS_KEY_SECRET=your_access_key_secret
OSS_BUCKET=your_bucket_name
OSS_REGION=oss-cn-hangzhou

# --- 钉钉互动卡片配置（可选） ---
# 在钉钉开发者后台创建的卡片模板ID
DINGTALK_CARD_TEMPLATE_ID=your_card_template_id.schema
# 群会话ID（通过API获取，群聊场景必填）
# DINGTALK_OPEN_CONVERSATION_ID=your_open_conversation_id

# --- 系统配置 ---
# 服务端口
PORT=3000
# 日志级别
LOG_LEVEL=info
# 数据存储路径
DATA_DIR=./data
